{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(local)\\SQLEXPRESS;Database=TrainWebDb;Trusted_Connection=true;Encrypt=false;"
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-change-in-production-min-32-chars-12345",
    "Issuer": "TrainWebAPI",
    "Audience": "TrainWebClient",
    "ExpirationMinutes": 1440
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "https://localhost:3000"
    ]
  }
}
