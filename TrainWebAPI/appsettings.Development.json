{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Key": "${{ secrets.JWT_KEY }}",
    "Issuer": "TrainWebAPI",
    "Audience": "TrainWebUsers"
  },

  "Map": {
    "ApiKey": "${{ secrets.MAP_API_KEY }}"
  },

  "MoMo": {
    "PartnerCode": "${{ secrets.MOMO_PARTNER_CODE }}",
    "AccessKey": "${{ secrets.MOMO_ACCESS_KEY }}",
    "SecretKey": "${{ secrets.MOMO_SECRET_KEY }}",
    "Endpoint": "https://payment.momo.vn/v2/gateway/api/create",
    "RedirectUrl": "https://your-deploy-domain/payment-return",
    "IpnUrl": "https://your-deploy-domain/payment-notify"
  }
}
